{
	"name": "@gjuoun/safe-ts",
	"version": "0.1.0",
	"description": "One effect system for TypeScript without a fiber runtime: a lazy Safe<A, E, R> with one Safe.call boundary, Safe.try sequencing, a Scheduler for cancellation, a flat Outcome, class services and finalizers.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"sideEffects": false,
	"license": "MIT",
	"keywords": [
		"typescript",
		"effect",
		"result",
		"typed-errors",
		"dependency-injection",
		"cancellation",
		"zero-dependencies",
		"esm"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gjuoun/safe-ts.git"
	},
	"homepage": "https://github.com/gjuoun/safe-ts#readme",
	"bugs": {
		"url": "https://github.com/gjuoun/safe-ts/issues"
	},
	"engines": {
		"node": ">=20.3"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "bun test",
		"build": "bun run scripts/build.ts",
		"prepare": "bun run build",
		"prepublishOnly": "bun run check && bun run build",
		"docs:check": "bun run scripts/doc-check.ts",
		"bench": "bun run bench/run.ts",
		"bench:tax": "bun run bench/tax.ts",
		"check": "bun run typecheck && bun run lint && bun run test && bun run docs:check"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@types/bun": "latest",
		"dts-bundle-generator": "10",
		"effect": "^4.1.4",
		"neverthrow": "^8.2.0",
		"typescript": "5.9.3"
	}
}
